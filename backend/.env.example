# Copy to .env for local development. Never commit .env.
NODE_ENV=development

# The frontend calls http://localhost:8000/api/v1 (frontend/.env.development).
PORT=8000

# Local Postgres from infrastructure/docker-compose.yml.
# connection_limit is the Prisma pool size per instance (see docs/capacity-and-load-test.md).
DATABASE_URL=postgresql://eduline:eduline_dev@localhost:5432/eduline?schema=public&connection_limit=10&pool_timeout=10

# At least 32 random characters. Production reads it from Secret Manager.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Used to build links in emails, e.g. the password reset page.
FRONTEND_URL=http://localhost:5173

# Rate limits, per user (or per IP when not logged in), per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# How emails are sent:
#   console = print to the API log (development only, refused in production)
#   outbox  = write an EMAIL_REQUESTED event for the worker (M6) to send
MAIL_TRANSPORT=console

# Number of proxies in front of the API (Cloud Run + load balancer). Used to read the client IP.
TRUST_PROXY_HOPS=1

# Used by `npm run seed` to create the first Admin account.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@eduline.local
# Quoted because "#" otherwise starts a comment.
SEED_ADMIN_PASSWORD="Admin#2026"
SEED_ADMIN_FIRST_NAME=EduLine
SEED_ADMIN_LAST_NAME=Admin

# Video lessons without an uploaded file play this sample outside production
# (until the media service signs real uploads). Leave empty to disable.
DEV_SAMPLE_VIDEO_URL=https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm

# Notifications: how often the API turns outbox events into notifications
# (0 = off), how many failures before an event is skipped, and the secret for
# POST /internal/outbox/flush (Cloud Scheduler). Empty token disables that route.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
INTERNAL_API_TOKEN=

# How often the API queues "assignment due within 24 h" reminders (0 = off).
# Also triggerable by Cloud Scheduler: POST /internal/jobs/assignment-reminders.
ASSIGNMENT_REMINDER_INTERVAL_MS=900000
