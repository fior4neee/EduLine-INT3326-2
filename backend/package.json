{
  "name": "eduline-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EduLine API: NestJS modular monolith",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:demo": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-demo.ts",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects int --runInBand",
    "seed:m3": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-m3.ts",
    "seed:catalog": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed-catalog.ts",
    "eval:scoring": "ts-node --transpile-only scripts/eval/scoring-vmlu.ts",
    "eval:progress": "ts-node --transpile-only scripts/eval/progress-replay.ts",
    "eval:analytics": "ts-node --transpile-only scripts/eval/analytics-crosscheck.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "jest": {
    "testTimeout": 15000,
    "projects": [
      {
        "displayName": "unit",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "diagnostics": false
            }
          ]
        }
      },
      {
        "displayName": "int",
        "rootDir": "test",
        "testRegex": ".*\\.int-spec\\.ts$",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "diagnostics": false
            }
          ]
        },
        "setupFiles": [
          "<rootDir>/setup-env.ts"
        ]
      }
    ]
  }
}
