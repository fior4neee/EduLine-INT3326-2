{
  "name": "eduline-notification-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Pub/Sub HTTP push worker reusing EduLine notification services",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "prisma:generate": "node scripts/prepare-prisma.mjs && prisma generate --schema build/prisma/schema.prisma",
    "db:test:migrate": "node scripts/migrate-test-db.mjs",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/worker/src/main.js",
    "test": "npm run build && node --test dist/worker/test/push-message.test.js dist/worker/test/server.test.js",
    "test:int": "npm run build && node --test dist/worker/test/notification.integration.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "prisma": "6.19.3",
    "typescript": "5.8.3"
  }
}
